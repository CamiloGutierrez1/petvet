# Valores ficticios para el entorno local de desarrollo.
PETVET_DB_USER=petvet
PETVET_DB_PASSWORD=petvet_local
PETVET_RABBITMQ_USER=petvet
PETVET_RABBITMQ_PASSWORD=petvet_local
PETVET_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Horarios locales de demostración, por confirmar con el equipo.
PETVET_AGENDA_ZONA=America/Bogota
PETVET_AGENDA_APERTURA=08:00
PETVET_AGENDA_CIERRE=18:00
PETVET_AGENDA_DURACION_MINUTOS=30

# Vacunas ficticias. Revisión diaria a las 8 a. m. en la zona de la agenda.
PETVET_VACUNAS_CRON="0 0 8 * * *"
PETVET_VACUNAS_DIAS_AVISO=7
PETVET_VACUNAS_HABILITADAS=true

# Publicación de eventos pendientes, con reintento cada cinco segundos.
PETVET_EVENTOS_HABILITADOS=true
PETVET_EVENTOS_INTERVALO_MS=5000
