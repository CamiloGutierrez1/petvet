# Valores ficticios para el entorno local de desarrollo.
PETVET_DB_USER=petvet
PETVET_DB_PASSWORD=petvet_local
PETVET_RABBITMQ_USER=petvet
PETVET_RABBITMQ_PASSWORD=petvet_local
PETVET_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Agenda de Citas. La zona también llega a Mascotas y Dueños y a Notificaciones.
# Cada veterinario tiene su propio horario en la base de Citas; apertura y cierre
# solo se usan para un veterinario sin horario. La duración debe dividir
# exactamente la jornada de apertura a cierre o Citas no arranca.
PETVET_AGENDA_ZONA=America/Bogota
PETVET_AGENDA_APERTURA=08:00
PETVET_AGENDA_CIERRE=18:00
PETVET_AGENDA_DURACION_MINUTOS=30

# Vacunas ficticias. Revisión diaria a las 8 a. m. en la zona de la agenda.
PETVET_VACUNAS_CRON="0 0 8 * * *"
PETVET_VACUNAS_DIAS_AVISO=7
PETVET_VACUNAS_HABILITADAS=true

# Historial de ejemplo de Tobby, Misha y Kiwi, las mascotas 1, 2 y 3 de los
# datos iniciales de Mascotas y Dueños. El Compose de demo ya lo carga.
# PETVET_CITAS_MIGRACIONES=classpath:db/migration,classpath:db/demo

# Publicación de eventos pendientes, con reintento cada cinco segundos.
PETVET_EVENTOS_HABILITADOS=true
PETVET_EVENTOS_INTERVALO_MS=5000

# Base de la fotoUrl de las fotos subidas a Mascotas y Dueños. La usa el
# navegador, por eso apunta al puerto publicado en localhost.
PETVET_FOTOS_URL_BASE=http://localhost:8081

# Remitente de los correos de Notificaciones, que llegan a MailHog
# (http://localhost:8025).
PETVET_NOTIFICACIONES_REMITENTE="PetVet <notificaciones@petvet.local>"

# Frontend (http://localhost:5173). true: la imagen usa los datos simulados
# del front en vez de la API real. Se aplica al construir la imagen
# (docker compose --profile app up -d --build frontend).
PETVET_FRONT_USE_MOCKS=false
