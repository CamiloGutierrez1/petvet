# Copia este archivo como .env (el .env no se sube a Git).
VITE_API_MASCOTAS=http://localhost:8081/api
VITE_API_CITAS=http://localhost:8082/api

# true: usa los datos simulados de src/mocks. false: llama a la API real.
VITE_USE_MOCKS=true

# Opcional: un interruptor por microservicio. Si se definen, mandan sobre
# VITE_USE_MOCKS. Ejemplo: Citas real y Mascotas simulado mientras Pia termina.
# VITE_USE_MOCKS_MASCOTAS=true
# VITE_USE_MOCKS_CITAS=false
